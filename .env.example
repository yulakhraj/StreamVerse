# Default same-origin fallback, served by npm run proxy / npm start.
VITE_STREAM_PROXY=/api/stream
# Set VITE_STREAM_PROXY= to disable the fallback for a frontend-only build.
# Server runtime defaults: PORT=8787, HOST=127.0.0.1

# Vercel server-only: configure a random 32-byte key in project environment settings.
# STREAM_PROXY_SECRET must be the same across function instances; never prefix it VITE_.
